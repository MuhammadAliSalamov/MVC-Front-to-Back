@using MVCIntro.Models
@model List<Category>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Categories</h4>
                        <button type="button" class="btn btn-success btn-fw mb-3">
                            <b class="mdi mdi-plus">Add Category</b>
                        </button>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>ID</th>
                                        <th>Name</th>
                                        <th>Created</th>
                                        <th>IsActive</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Category category in Model)
                                    {
                                        <tr>
                                            <td>@category.Id</td>
                                            <td>@category.Name</td>
                                            <td>@category.CreatedAt.ToString("dd MMM yyyy")</td>
                                            <td>
                                                @if (category.IsDeleted)
                                                {
                                                    <span class="badge bg-danger">Deleted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-danger btn-fw mb-3">
                                                    <i class="mdi mdi-delete"></i>
                                                </button>

                                                <button type="button" class="btn btn-warning btn-fw mb-3">
                                                    <i class="mdi mdi-pencil"></i>
                                                </button> 

                                                <button type="button" class="btn btn-info btn-fw mb-3">
                                                    <i class="mdi mdi-information"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }                                   
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
</div>