@using MVCIntro.ViewModels.Account
@model RegisterVM
<main class="main-content">
    <div class="login-register-area section-space-y-axis-100">
        <div class="container">
            <div class="row justify-content-center">

                <div class="col-lg-6 pt-5 pt-lg-0">
                    <form action="#" method="post">
                        <div class="login-form">
                            <h4 class="login-title">Register</h4>
                            <div class="row">
                                <div asp-validation-summary="ModelOnly" style="color: red;"></div>
                                <div class="col-md-6 col-12">
                                    <label asp-for="Name">Name</label>
                                    <input asp-for="Name" type="text" placeholder="First Name" />
                                    <span asp-validation-for="Name" style="color: red;"></span>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label asp-for="Surname">Surname</label>
                                    <input asp-for="Surname" type="text" placeholder="Last Name" />
                                    <span asp-validation-for="Surname" style="color: red;"></span>
                                </div>
                                <div class="col-md-6 col-12">
                                    <label asp-for="UserName">User Name</label>
                                    <input asp-for="UserName" type="text" placeholder="User Name" />
                                    <span asp-validation-for="UserName" style="color: red;"></span>
                                </div>
                                <div class="col-md-12">
                                    <label asp-for="Email">Email Address*</label>
                                    <input asp-for="Email" type="email" placeholder="Email Address" />
                                    <span asp-validation-for="Email" style="color: red;"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Password">Password</label>
                                    <input asp-for="Password" type="password" placeholder="Password" />
                                    <span asp-validation-for="Password" style="color: red;"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmPassword">Confirm Password</label>
                                    <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" />
                                    <span asp-validation-for="ConfirmPassword" style="color: red;"></span>
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-custom-size lg-size btn-pronia-primary">
                                        Register
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</main>