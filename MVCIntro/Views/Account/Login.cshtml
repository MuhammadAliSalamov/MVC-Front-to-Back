@model LoginVM

<main class="main-content">
  <div class="login-register-area section-space-y-axis-100">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-6">
          
          <form method="post" asp-controller="Account" asp-action="Login">
            
            <div class="login-form">
              <h4 class="login-title">Login</h4>
              
              <div asp-validation-summary="ModelOnly" class="text-danger"></div>

              <div class="row">
                <div class="col-lg-12">
                  <label>Email Or UserName</label>
                  <input asp-for="UserNameOrEmail" placeholder="Email Or UserName" class="form-control" />
                  <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>
                
                <div class="col-lg-12">
                  <label>Password</label>
                  <input asp-for="Password" type="password" placeholder="Password" class="form-control" />
                  <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                            <div class="col-md-8 col-12 mb-3">
                <div class="check-box">
                    <input type="checkbox" asp-for="IsPersisted" id="remember_me">
                    <label for="remember_me" style="margin-left: 5px;">Запомнить меня</label>
                </div>
                
                <div class="col-lg-12 pt-5">
                  <button type="submit" class="btn btn-custom-size lg-size btn-pronia-primary">
                    Login
                  </button>
                </div>
              </div>
            </div>
          </form>
          
        </div>
      </div>
    </div>
  </div>
</main>